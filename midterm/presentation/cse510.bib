@article{PHYSOR2010Advances2010,
  title = {{{PHYSOR}} 2010 : {{Advances}} in {{Reactor Physics}} to {{Power}} the {{Nuclear Renaissance}}},
  shorttitle = {{{PHYSOR}} 2010},
  date = {2010},
  journaltitle = {Journal of the Atomic Energy Society of Japan},
  shortjournal = {atomos},
  volume = {52},
  number = {8},
  pages = {500--500},
  issn = {1882-2606, 2433-7285},
  doi = {10.3327/jaesjb.52.8_500},
  url = {https://www.jstage.jst.go.jp/article/jaesjb/52/8/52_500/_article/-char/ja/},
  urldate = {2026-04-23},
  abstract = {Convergence acceleration methods for even-parity transport were developed that have the potential to speed up transport calculations and provide a natural avenue for an implicitly coupled multiphysics code. An investigation was performed into the acceleration properties of the introduction of a nonlinear quasi-diffusion-like tensor in linear and nonlinear solution schemes. Using the tensor reduced matrix as a preconditioner for the conjugate gradients method proves highly efficient and effective. The results for the linear and nonlinear case serve as the basis for further research into the application in a full three-dimensional spherical-harmonics even-parity transport code. Once moved into the nonlinear solution scheme, the implicit coupling of the convergence accelerated transport method into codes for other physics can be done seamlessly, providing an efficient, fully implicitly coupled multiphysics code with high order transport.},
  langid = {english},
  file = {/Users/lipohlmann/Zotero/storage/EKAD25CS/2010 - PHYSOR 2010  Advances in Reactor Physics to Power the Nuclear Renaissance.pdf}
}

