# Build everything, submit every job the report needs, then plot.  All
# CSV files land in one output directory (default results) and the
# figures in ../report/figures:
#
#   ./driver                 # results/
#   ./driver my_results
#
# GRID_SIZES etc. are passed through to the jobs, e.g.
#   GRID_SIZES="32 128 512 2048 8192" ./driver

OUTPUT_DIR=${1:-results}

# Build for a cpu every compute node has, not for the login node's
# (-march=native there gives "Illegal instruction" on the compute nodes).
ARCH=${ARCH:-x86-64-v3}

module load openmpi
make clean
make ARCH="$ARCH" || exit 1

# test_poisson over N, P, both transposes
sweep_job=$(sbatch --parsable sweep.sbatch "$OUTPUT_DIR")
# point-to-point, within and across nodes
pingpong_job=$(sbatch --parsable pingpong.sbatch "$OUTPUT_DIR")
# single-core FST over (m, n)
fst_sweep_job=$(sbatch --parsable fst_sweep.sbatch "$OUTPUT_DIR")
echo "submitted sweep $sweep_job, pingpong $pingpong_job, fst sweep $fst_sweep_job"

# Plot once all three have finished, whether or not they all succeeded;
# plot_results.py skips figures whose data is missing.
sbatch --dependency=afterany:$sweep_job:$pingpong_job:$fst_sweep_job \
    plot.sbatch "$OUTPUT_DIR"
